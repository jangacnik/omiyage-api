DB_HOST=localhost
DB_PORT=5433
DB_NAME=omiyage
DB_USER=omiyage
DB_PASSWORD=omiyage

# Dev/test profiles may use a short secret; any other profile requires >= 32 bytes and not this value.
SPRING_PROFILES_ACTIVE=dev
# Must match MeishiApi's JWT_SECRET env var — Omiyage verifies tokens Meishi issues.
MEISHI_JWT_SECRET=dev-secret-change-me
# Rotation: change this value in both MeishiApi (JWT_SECRET) and Omiyage together.
MEISHI_API_URL=http://localhost:8080
